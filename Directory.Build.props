<Project>

  <!-- Central versioning for all projects (desktop app, Android app, libraries). -->
  <PropertyGroup>
    <ImmortalSnailChessVersionMajor>1</ImmortalSnailChessVersionMajor>
    <ImmortalSnailChessVersionMinor>0</ImmortalSnailChessVersionMinor>
    <ImmortalSnailChessVersionPatch>0</ImmortalSnailChessVersionPatch>

    <Version>$(ImmortalSnailChessVersionMajor).$(ImmortalSnailChessVersionMinor).$(ImmortalSnailChessVersionPatch)</Version>
    <AssemblyVersion>$(Version).0</AssemblyVersion>
    <FileVersion>$(Version).0</FileVersion>
  </PropertyGroup>

</Project>
